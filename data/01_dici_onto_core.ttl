                        rdfs:subClassOf dici_core:Attribute ;
                        rdfs:label "Cost Attribute" ;
                        dici_core:hasDefaultUnit unit:ONE .

###  https://digicities.info/ontology#CurveAttribute
dici_core:CurveAttribute a owl:Class ;
                         rdfs:subClassOf dici_core:Attribute ,
                                         [ a owl:Restriction ;
                                           owl:onProperty dici_core:xAttribute ;
                                           owl:someValuesFrom qudt:QuantityKind
                                         ] ,
                                         [ a owl:Restriction ;
                                           owl:onProperty dici_core:xUnit ;
                                           owl:someValuesFrom qudt:Unit
                                         ] ,
                                         [ a owl:Restriction ;
                                           owl:onProperty dici_core:yAttribute ;
                                           owl:someValuesFrom qudt:QuantityKind
                                         ] ,
                                         [ a owl:Restriction ;
                                           owl:onProperty dici_core:yUnit ;
                                           owl:someValuesFrom qudt:Unit
                                         ] ,
                                         [ a owl:Restriction ;
                                           owl:onProperty dici_core:hasAttributeValue ;
                                           owl:someValuesFrom rdfs:Literal
                                         ] ;
                         rdfs:label "Curve Attribute" ;
                         dici_core:definition "An attribute represented by a set of x,y coordinate pairs forming a curve"@en .

###  https://digicities.info/ontology#Damper
dici_core:Damper a owl:Class ;
                 rdfs:subClassOf dici_core:Actuator ;
