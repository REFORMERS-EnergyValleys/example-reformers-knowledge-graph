                                        ] ,
                                        [ a owl:Restriction ;
                                          owl:onProperty dici_core:currency ;
                                          owl:someValuesFrom fibo-currency:Currency
                                        ] ,
                                        [ a owl:Restriction ;
                                          owl:onProperty qudt:numericValue ;
                                          owl:someValuesFrom xsd:decimal
                                        ] ;
                        rdfs:label "Unit-based Cost" .

