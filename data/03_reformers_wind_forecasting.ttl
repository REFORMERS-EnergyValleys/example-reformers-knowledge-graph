@prefix wind_turbine: <urn:reformers:wind_forecasting:wind_turbine:> .

wind_forecasting:Baseline a dici_core:Scenario ;
    rdfs:label "Baseline" .

windpark_alkmaar:WindparkAlkmaar a dici_reformers:GlobalWindAtlasSite ;
    rdfs:label "WindparkAlkmaar" ;
    dici_reformers:hasGlobalWindAtlasSiteRoughnessAttribute windpark_alkmaar:Roughness ;
    dici_core:usedInScenario wind_forecasting:Baseline .

windpark_alkmaar:Roughness a dici_reformers:Roughness ;
    qudt:value "1.0"^^xsd:decimal ;
    dici_core:usedInScenario wind_forecasting:Baseline .

